# Copy this file to `.env` in the repository root. docker-compose reads it
# automatically and the backend also loads it when run outside Docker.
# The Configuration page in the UI edits the same file.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=assistant_password
POSTGRES_DB=assistant_db
# Only used when running the backend outside Docker (compose overrides it).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/assistant_db

# ── Google OAuth2 (required) ─────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# ── Token encryption (required) ──────────────────────────────────────────────
# Key for the AES encryption of Google tokens stored in the database.
# Must be exactly 16, 24 or 32 characters. Generate one with:
#   openssl rand -hex 16
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ── Optional integrations ────────────────────────────────────────────────────
# Powers the Assistant page. Leave empty to disable the assistant.
OPENAI_API_KEY=
# Powers the Maps page and travel-time estimates. Baked into the frontend
# image at build time, so rebuild (./build.sh) after changing it.
VITE_GOOGLE_MAPS_API_KEY=
# Telegram bot that forwards messages to the assistant. Leave empty to disable.
TELEGRAM_BOT_TOKEN=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Where the browser reaches the UI. Used for the OAuth2 success redirect and CORS.
APP_FRONTEND_URL=http://localhost:5173

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# The native bridge (QR-code login) needs no credentials. Compose sets its URL.
BRIDGE_URL=http://whatsapp-bridge:3001
# Your own number in international format, used by the UI to label your messages.
WHATSAPP_PHONE_NUMBER=+33123456789
# Only for the legacy Meta Cloud API webhook (/api/whatsapp/webhook).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
